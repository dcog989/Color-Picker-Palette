{
  "name": "color-picker-palette",
  "description": "The only color picker palette generator you need.",
  "version": "3.9.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "changelog": "cog changelog",
    "check": "biome check . && bun run typecheck && bun run test:coverage && bun run build",
    "clean": "rm -rf bun.lock coverage dist node_modules .vitest",
    "dev": "vite",
    "fix": "biome check --write .",
    "postinstall": "lefthook install",
    "preview": "vite preview",
    "release": "cog bump --auto",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "svelte-check --tsconfig ./tsconfig.app.json && bun --check",
    "update": "bun update --latest",
    "version": "cog bump --version"
  },
  "dependencies": {
    "@colordx/core": "^7.3.0",
    "@lucide/svelte": "^1.58.0",
    "color-name-list": "^14.57.0",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "typescript": "6.0.3"
  }
}
